# Copy this file to .env and adjust as needed.
#
# ⚠️  Vite only exposes variables prefixed with VITE_ to the browser, and ANY
# VITE_ variable is bundled into the public client code. NEVER put real secrets
# or API keys here — they would be visible to every visitor.

# App display name
VITE_APP_NAME=Affinityx QR

# Domain used when generating short links for dynamic QR codes
VITE_SHORT_URL_DOMAIN=affinityx.com

# Backend API base URL (use /api/v1 with the Vite dev proxy, or full URL in production)
VITE_API_URL=/api/v1

# Google OAuth client ID (public — safe to expose in the browser)
VITE_CLIENT_ID=391652936376-ie1vimbi9jjvj8l1vlkqlb7p11mdatd8.apps.googleusercontent.com