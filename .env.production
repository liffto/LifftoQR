# Production build defaults (baked into the browser bundle by Vite).
# Override on Vercel if the API hostname changes. Never put secrets here.

VITE_APP_NAME=Liffto QR
VITE_SHORT_URL_DOMAIN=liffto-qr.vercel.app

# Website and API are separate Vercel projects — call the API origin directly.
VITE_BACKEND_API_URL=https://liffto-qr.vercel.app
VITE_WS_BASE_URL=wss://liffto-qr.vercel.app

# Google OAuth client ID (public — safe to expose in the browser)
VITE_CLIENT_ID=391652936376-ie1vimbi9jjvj8l1vlkqlb7p11mdatd8.apps.googleusercontent.com
